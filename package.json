{
  "name": "a-dois",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase/functions"
  ],
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/api/src/database.types.ts",
    "test:rls": "bash supabase/tests/run.sh",
    "db:types:check": "npm run db:types && git diff --exit-code packages/api/src/database.types.ts",
    "guardas": "bash scripts/guarda-rls.sh && bash scripts/guarda-portabilidade.sh",
    "test:e2e": "npm run test:e2e --workspace web"
  },
  "devDependencies": {
    "supabase": "2.117.0",
    "turbo": "^2.10.12",
    "typescript": "^5"
  }
}
