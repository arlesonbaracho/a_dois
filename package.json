{
  "name": "a-dois",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/api/src/database.types.ts",
    "test:rls": "bash supabase/tests/run.sh"
  },
  "devDependencies": {
    "supabase": "2.117.0",
    "turbo": "^2.10.12",
    "typescript": "^5"
  }
}
